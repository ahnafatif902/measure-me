<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only sets the window background
         so there is no white flash before the first frame. Both system bars
         are transparent because the activity is edge-to-edge. -->
    <style name="Theme.MeasureMe" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
